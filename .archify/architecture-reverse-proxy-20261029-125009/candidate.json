      "dot": "cyan",
      "title": "Nginx Proxy Rules",
      "items": [
        "location /fmi/ forwards to https://192.168.x.x/fmi/ with trailing slashes matched",
        "proxy_ssl_verify off accepts FMS's self-signed cert over the private LAN"
      ]
    },
    {
      "dot": "amber",
      "title": "No FMS Cert Maintenance",
      "items": [
        "FileMaker Server keeps its default self-signed certificate untouched",
        "Let's Encrypt renewal stays centralized on the primary web server"
