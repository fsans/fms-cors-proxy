  "cards": [
    {
      "dot": "rose",
      "title": "Preflight & Origin Reflection",
      "items": [
        "Matches http://192.168.x.*(:port) via RewriteCond and reflects ALLOW_ORIGIN",
        "Intercepts OPTIONS requests with RewriteRule ^ - [R=200,L] to prevent 405 errors"
      ]
    },
    {
      "dot": "cyan",
      "title": "OData Header Allowlist",
      "items": [
        "Explicitly allows Authorization, Accept, Prefer, OData-Version, and OData-MaxVersion",
        "Removes legacy global Access-Control-Allow-Origin ${SERVER_NAME} lines"
      ]
    },
    {
      "dot": "amber",
      "title": "Safe Apache Reload",
      "items": [
        "Sync edits across httpd.conf (HTTP/1.1) and httpd.conf.2.4 (HTTP/2)",
        "Reload with sudo launchctl kickstart -k system/com.filemaker.httpd.graceful"
      ]
    }
